rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // All student documents, payment slips, and admin-uploaded offer
    // letters live under documents/<category>/<timestamp>_<filename> (see
    // lib/uploadFile.js). Paths aren't scoped per-user, so any signed-in
    // account can read/write here - the actual access boundary is enforced
    // one layer up, in Firestore: a file's download URL is only ever
    // exposed to its owning student or an admin via the `applications`
    // collection's security rules. This still closes off the real risk
    // from test mode, which is completely unauthenticated access.
    match /documents/{category}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
